# Copy to .env.local for local dev with `npx vercel dev`. NEVER commit real values.
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.

# Public (safe in the browser: they only work together with row-level security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (no VITE_ prefix!)
GROQ_API_KEY=
SPOONACULAR_API_KEY=
SERPAPI_KEY=
CRON_SECRET=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
